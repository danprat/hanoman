DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman
PORT=8787

# Tests seed with a wipe-then-load and run against an ISOLATED database so they
# never touch DATABASE_URL's data. By default vitest derives `<db>_test` from
# DATABASE_URL (e.g. hanoman_test); set this to override. It must differ from
# DATABASE_URL — vitest refuses to run otherwise. Create + migrate it once with:
#   DATABASE_URL=<this> pnpm --filter ./server exec prisma migrate deploy
# TEST_DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman_test

# Sesi terminal hidup di tmux server dengan socket sendiri (ADR-0016), terpisah dari
# tmux milikmu. Ubah hanya kalau namanya bentrok.
# HANOMAN_TMUX_SOCKET=hanoman

# Biner `claude` yang di-spawn tiap sesi. Default: `claude` di PATH.
# HANOMAN_CLAUDE_BIN=claude

# Sesi claude interaktif memakai kredensial pengguna yang sudah login (`claude` di
# terminal biasa). Setel ini hanya bila prosesnya berjalan tanpa keychain yang bisa
# dibaca — mis. di dalam container. Alternatifnya ANTHROPIC_API_KEY.
# CLAUDE_CODE_OAUTH_TOKEN=
