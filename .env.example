DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman
REDIS_URL=redis://localhost:6379
PORT=8787

# Tests seed with a wipe-then-load and run against an ISOLATED database so they
# never touch DATABASE_URL's data. By default vitest derives `<db>_test` from
# DATABASE_URL (e.g. hanoman_test); set this to override. It must differ from
# DATABASE_URL — vitest refuses to run otherwise. Create + migrate it once with:
#   DATABASE_URL=<this> pnpm --filter ./server exec prisma migrate deploy
# TEST_DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman_test

# GitHub App (SPEC-006) — webhook verify + installation-token clone/push/status.
# Server-side only; tokens are minted on demand and never persisted.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# PEM contents of the app private key (keep the -----BEGIN/END----- lines).
GITHUB_APP_PRIVATE_KEY=

# Claude auth for the headless runner (@anthropic-ai/claude-agent-sdk). Using a
# Claude Code Pro/Max subscription instead of an API key: run `claude setup-token`
# on an interactive machine and paste the long-lived token here. The worker reads
# this from env (no keychain access, which is unreliable for background processes).
# Alternatively set ANTHROPIC_API_KEY for direct Console API billing.
CLAUDE_CODE_OAUTH_TOKEN=
