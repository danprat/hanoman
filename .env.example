# hanoman — template konfigurasi DEV. Salin ke `.env` (gitignored) lalu isi.
# Dimuat oleh server/src/env.ts (walk-up cari .env terdekat) dan server/vitest.config.ts.
# Var yang SUDAH ada di environment tidak pernah ditimpa (CI/prod set langsung).
# Frontend (Vite) tak butuh env apa pun: dashboard proxy ke /api, tak ada var VITE_.
#
# SPEC-215 · Semua knob NON-bootstrap di bawah (+ kredensial) JUGA dapat diatur runtime dari
# dashboard → Settings → Konfigurasi (override DB menang atas env, sebagian berlaku live).
# Bootstrap (DATABASE_URL, TEST_DATABASE_URL, PORT, HOST, NODE_ENV) tetap env-only (read-only di UI).

# ── Wajib ──────────────────────────────────────────────────────────────────────
# Postgres (Prisma).
DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman

# ── API ────────────────────────────────────────────────────────────────────────
PORT=8787
# Default bind 127.0.0.1 (server.ts). hanoman punya auth (SPEC-169) tapi cookie `Secure`
# butuh TLS — set HOST=0.0.0.0 HANYA di belakang reverse-proxy yang menerminasi TLS (ADR-0028).
# HOST=127.0.0.1

# ── Auth Claude (untuk `claude` headless yang di-spawn tiap sesi terminal, ADR-0016) ──
# Di macOS dev, app & claude memakai Keychain, jadi ini OPSIONAL. Di mesin tanpa keychain
# (container/VPS) jalankan `claude setup-token` di mesin interaktif lalu tempel token panjang
# di sini; nilainya diteruskan apa adanya ke proses claude. Alternatif: ANTHROPIC_API_KEY
# untuk billing Console API langsung.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Direktori config Claude tempat `.credentials.json` dibaca (panel usage/limit, services/limits.ts).
# Default ~/.claude. Di macOS token diambil dari Keychain kecuali var ini di-set.
# CLAUDE_CONFIG_DIR=

# ── Knob opsional (punya default yang wajar) ────────────────────────────────────
# Biner `claude` yang di-spawn tiap sesi. Default: `claude` di PATH.
# HANOMAN_CLAUDE_BIN=claude

# Sesi terminal hidup di tmux server dengan socket sendiri (ADR-0016), terpisah dari tmux-mu.
# Default `hanoman`. Ubah hanya kalau bentrok. (Test memaksa `hanoman-test`; prod `hanoman-prod`.)
# HANOMAN_TMUX_SOCKET=hanoman

# Interval polling stream events/SSE dalam ms. Default 1000.
# HANOMAN_EVENTS_TICK_MS=1000

# Deteksi update lewat `git fetch` saat boot server nyata (default registry "1"). Set "0" mematikan.
# HANOMAN_UPDATE_FETCH=1

# ── Peran sync CLIENT (SPEC-213, opsional) ──────────────────────────────────────
# Tanpa SYNC_SERVER_URL instance ini murni HUB (perilaku lama, backward-compatible). Isi keduanya
# agar ia menyinkron ke hub remote memakai device token yang diterbitkan hub tersebut.
# SYNC_SERVER_URL=https://hub.example.com
# SYNC_DEVICE_TOKEN=
# Interval polling sync client dalam ms. Default 15000.
# SYNC_TICK_MS=15000

# ── Deploy ke VPS lewat SSH (routes/services vps-*, opsional) ────────────────────
# Direktori tempat key SSH hanoman disimpan. Default ~/.hanoman.
# HANOMAN_SSH_KEY_DIR=

# ── Test ────────────────────────────────────────────────────────────────────────
# Test menyeed dengan wipe-then-load dan jalan di DB TERISOLASI, tak pernah menyentuh data
# DATABASE_URL. Default vitest menurunkan `<db>_test` dari DATABASE_URL (mis. hanoman_test);
# set di sini untuk override. Wajib beda dari DATABASE_URL — vitest menolak jalan kalau sama.
# Bikin + migrate sekali:
#   DATABASE_URL=<ini> pnpm --filter ./server exec prisma migrate deploy
# TEST_DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman_test
