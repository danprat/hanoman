# Production. Disalin ke `.env.production` (gitignored) dan dibaca oleh `pnpm prod:*`,
# yang mengekspornya SEBELUM node boot. env.ts tidak pernah menimpa var yang sudah ada,
# jadi nilai di sini menang atas `.env` dev; kunci yang tidak disebut di sini tetap
# jatuh ke `.env` (CLAUDE_CODE_OAUTH_TOKEN, kredensial GitHub App).

# Database terpisah, instance Postgres yang sama. Bikin + migrate: `pnpm prod:setup`.
DATABASE_URL=postgresql://hanoman:hanoman@localhost:5432/hanoman_prod

# Redis db index 3. WAJIB bukan 0: worker dev mendengarkan di db 0 dan akan
# melahap job prod sebagai run-nya sendiri.
REDIS_URL=redis://localhost:6379/3

PORT=8788

# Menyajikan dashboard hasil `pnpm build` dari src/dist lewat proses api.
NODE_ENV=production

# Run id menentukan path worktree (`<repoDir>/.worktrees/<run-id>`), dan floor-nya
# per-database. Dev mulai dari 8800; prod harus punya namespace sendiri, kalau tidak
# kedua instance mengalokasikan RUN-8801 dan saling force-remove worktree.
RUN_ID_FLOOR=90000
