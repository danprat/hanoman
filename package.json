{
  "name": "hanoman",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "predev": "docker compose up -d --wait",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "pnpm --filter ./server dev",
    "dev:worker": "pnpm --filter ./server worker",
    "dev:web": "pnpm --filter ./src dev",
    "worker": "node server/dist/worker.js",
    "build": "pnpm --filter ./src build && pnpm --filter ./server build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --no-file-parallelism"
  },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
