{
  "name": "hanoman",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "predev": "docker compose up -d --wait",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "pnpm --filter ./server dev",
    "dev:worker": "pnpm --filter ./server worker",
    "dev:web": "pnpm --filter ./src dev",
    "worker": "node server/dist/worker.js",
    "prod:db": "docker compose up -d --wait && (docker compose exec -T db psql -U hanoman -d postgres -c 'CREATE DATABASE hanoman_prod' 2>/dev/null || true)",
    "prod:setup": "pnpm prod:db && set -a && . ./.env.production && set +a && pnpm --filter ./server exec prisma migrate deploy && pnpm build",
    "prod:api": "set -a && . ./.env.production && set +a && node server/dist/server.js",
    "prod:worker": "set -a && . ./.env.production && set +a && node server/dist/worker.js",
    "preprod": "pnpm prod:setup",
    "prod": "pnpm run \"/^prod:(api|worker)$/\"",
    "build": "pnpm --filter ./src build && pnpm --filter ./server build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --no-file-parallelism"
  },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
