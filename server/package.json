{
  "name": "@hanoman/server",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --external:fastify --external:@fastify/static --external:@prisma/client --external:node-pty --external:@fastify/websocket --external:@fastify/cookie --external:pdfkit --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.0",
    "@fastify/websocket": "^10.0.1",
    "@hanoman/runner": "workspace:*",
    "@hanoman/shared": "workspace:*",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@prisma/client": "^6.19.0",
    "fastify": "^4.28.0",
    "marked": "^12.0.2",
    "node-pty": "^1.1.0",
    "pdfkit": "^0.19.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.23.0",
    "prisma": "^6.19.0",
    "tsx": "^4.16.0",
    "ws": "^8.21.0"
  }
}
