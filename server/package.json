{
  "name": "@hanoman/server",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dev": "tsx watch src/server.ts",
      "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --external:fastify --external:@fastify/static --external:@prisma/client --external:node-pty --external:@fastify/websocket",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/static": "^7.0.0",
    "@fastify/websocket": "^10.0.1",
    "@hanoman/runner": "workspace:*",
    "@hanoman/shared": "workspace:*",
    "@octokit/auth-app": "^7.0.0",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.79.2",
    "cron-parser": "^4.9.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.11.1",
    "node-pty": "^1.1.0",
    "octokit": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.23.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.0",
    "ws": "^8.21.0"
  }
}
